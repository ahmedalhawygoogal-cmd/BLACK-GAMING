# BLACK GAMING Environment Variables

# Supabase Database Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# WhatsApp Support Number (Egypt)
NEXT_PUBLIC_WHATSAPP_NUMBER=+201554893945

# Admin Panel (Phase 5)
# Password used to access /admin (fallback is built in when omitted)
ADMIN_PASSWORD=change-me
# Secret used to sign the admin session cookie (set a long random value)
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string
